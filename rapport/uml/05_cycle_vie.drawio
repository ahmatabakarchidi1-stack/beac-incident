        <mxCell id="e1desc" value="Ali déclare le problème&#xa;L'IA le trie automatiquement" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="175" width="210" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="e2desc" value="Le Responsable donne le problème&#xa;à un technicien qui le répare" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="280" y="355" width="210" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="e3desc" value="Le technicien a terminé&#xa;En attente de confirmation d'Ali" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
