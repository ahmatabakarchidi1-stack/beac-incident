          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="Le Responsable affecte" style="endArrow=block;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="e2" target="e3">
