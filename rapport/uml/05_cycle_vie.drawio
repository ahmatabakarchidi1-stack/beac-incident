        </mxCell>
        <mxCell id="e4desc" value="Ali a confirmé ✅&#xa;Le problème est clôturé" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="780" y="355" width="210" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="e5desc" value="Ali a dit que ça ne marche pas ❌&#xa;Retour au technicien" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="780" y="695" width="210" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="legende" value="LÉGENDE DU CYCLE DE VIE :&#xa;&#xa;• 1. EN ATTENTE (bleu) : Ali vient de déclarer le problème. L'IA le trie automatiquement.&#xa;• 2. EN COURS (jaune) : Le Responsable a donné le problème à un technicien qui le répare.&#xa;• 3. RÉSOLU (vert clair) : Le technicien a terminé. En attente de confirmation d'Ali.&#xa;• 4. FERMÉ (vert foncé) : Ali a confirmé que c'est réglé. Le problème est clôturé. ✅&#xa;• 5. RÉOUVERT (rouge) : Ali a dit que ça ne marche toujours pas. Retour au technicien. ❌&#xa;&#xa;CE CYCLE EST CONFORME AUX STANDARDS ITIL (Information Technology Infrastructure Library)" style="text;html=1;strokeColor=#999999;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="50" y="760" width="1300" height="130" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>